<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <PublishDir>./bin/K4-Arenas/plugins/K4-Arenas/</PublishDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <ProjectReference Include="../src-shared/K4-ArenaSharedApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- Template for addon authors, not part of this plugin -->
    <Compile Remove="K4-Arenas-Example.cs" />
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCustomFilesToPublishDirectory" AfterTargets="Publish">
    <Copy SourceFiles="$(ProjectDir)readme.txt" DestinationFolder="$(PublishDir)\" />
    <!-- CounterStrikeSharp copies this to K4-Arenas.json when no config exists yet -->
    <Copy SourceFiles="$(ProjectDir)K4-Arenas.example.json" DestinationFolder="$(PublishDir)../../configs/plugins/K4-Arenas/" />
    <!-- CS2 servers only run on linux-x64 and win-x64: drop SQLite's native builds for other platforms (~30 MB) -->
    <ItemGroup>
      <NativeRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))" />
      <UnusedNativeRuntimeDirs Include="@(NativeRuntimeDirs)" Condition="'%(Filename)' != 'linux-x64' And '%(Filename)' != 'win-x64'" />
    </ItemGroup>
    <RemoveDir Directories="@(UnusedNativeRuntimeDirs)" />
    <Copy SourceFiles="$(ProjectDir)../src-shared/bin/$(Configuration)/$(TargetFramework)/K4-ArenaSharedApi.dll" DestinationFolder="$(PublishDir)../../shared/K4-ArenaSharedApi/" />
  </Target>
</Project>
